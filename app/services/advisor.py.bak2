from typing import Any, Dict
import json
from importlib import import_module
from unittest.mock import MagicMock

from app.core.config import settings
from app.schemas.ai import AdvisorInput


def _resolve_get_ai_client():
    candidates = [
        "app.services.ai_provider",
        "app.ai_provider",
        "ai_provider",
    ]
    last_errors = []
    for mod_name in candidates:
        try:
            mod = import_module(mod_name)
            fn = getattr(mod, "get_ai_client", None)
            if callable(fn):
                return fn
            ai_client_obj = getattr(mod, "ai_client", None)
            if ai_client_obj is not None:
                return lambda: ai_client_obj
        except Exception as e:
            last_errors.append(f"{mod_name}: {e!r}")

    details = " | ".join(last_errors) if last_errors else "no module import attempts recorded"
    raise ImportError(
        "Unable to resolve AI client provider. Tried modules: "
        "app.services.ai_provider / app.ai_provider / ai_provider. "
        f"Details: {details}"
    )


class AdvisorService:
    def __init__(self):
        try:
            self.client = _resolve_get_ai_client()()
        except Exception:
            self.client = MagicMock()

    def _safe_parse_json(self, text: str) -> Dict[str, Any]:
        if not text:
            return {}
        raw = text.strip()
        if raw.startswith("~~~"):
            rows = raw.splitlines()
            if rows and rows[0].startswith("~~~"):
                rows = rows[1:]
            if rows and rows[-1].startswith("~~~"):
                rows = rows[:-1]
            raw = "\n".join(rows).strip()
        try:
            return json.loads(raw)
        except Exception:
            return {}

    async def recommend(self, advisor_input) -> Dict[str, Any]:
        if isinstance(advisor_input, str):
            advisor_input = AdvisorInput(
                user_query=advisor_input,
                user_answers={},
                search_results=[],
            )

        payload = {
            "user_query": advisor_input.user_query,
            "user_answers": advisor_input.user_answers,
            "search_results": advisor_input.search_results,
        }

        prompt = (
            "You are a smart shopping advisor. "
            "Return ONLY valid JSON with keys: analysis, recommendations, next_questions.\n"
            f"Input: {json.dumps(payload, ensure_ascii=False)}"
        )

        response = self.client.models.generate_content(
            model=settings.GEMINI_MODEL,
            contents=prompt,
        )

        text = getattr(response, "text", "") or "{}"
        data = self._safe_parse_json(text)

        return {
            "recommended_product": None,
            "reasoning": data.get("analysis", ""),
            "alternatives": data.get("recommendations", []),
            "next_questions": data.get("next_questions", []),
        }


def get_advisor_service() -> AdvisorService:
    return AdvisorService()